sum = 0 
num = int(input("Enter a 3 digit number"))
temp = num 
while temp > 0:
    firstnum = temp % 10
    temp = temp // 10  
    sum = sum + firstnum **3

if sum == num:
    print ("This is an armstrong number")
else:
    print ("This is not an armstrong number") 

